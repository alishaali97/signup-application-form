# Server
PORT=5000

# CORS - your frontend's public URL (http://EC2_PUBLIC_IP)
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

# Supabase project settings (Project Settings -> API in Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct Postgres connection string (Project Settings -> Database -> Connection string)
# Only needed if you query Postgres directly instead of via supabase-js
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
